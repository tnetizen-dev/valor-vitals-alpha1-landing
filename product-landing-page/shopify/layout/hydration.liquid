<!DOCTYPE html>
<!--
  Valor Vitals Hydration — Long-Form Sales Page (Shopify liquid)
  Layout half of the page. Ported from the verified static build at
  product-landing-page/hydration/index.html (v3, 2026-09-02) — read that
  file's own header comment for the full build history (v1 -> round-1 fix
  -> v2 restructure -> v3 rebuild). This port changes nothing about the
  design, copy, or interaction layer; it only adapts paths and head tags
  to Shopify conventions. See templates/page.hydration.liquid for the body
  and the flags specific to this port (Monster Cart, images, etc).

  Companion layout to layout/lander-v2.liquid (the A1 page) — same split
  convention: this layout owns the head and global CSS; the template
  declares this as its layout and the body content lands here via the
  layout tag's content-injection point.
-->
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Every Electrolyte Stick Has the Same Three Ingredients — Valor Vitals Hydration</title>
<meta name="description" content="Every electrolyte stick has the same three ingredients. We added a fourth. $29 for your first bag — 30 sticks, 30 days.">
<meta name="robots" content="noindex, nofollow">
<link rel="canonical" href="{{ canonical_url }}">
<!-- Real canonical now that this is a real Shopify page — Shopify computes
     this per-request. The static build left it as a TODO placeholder
     because no production URL existed yet to hardcode. -->

<!-- Pixel / GA4 / Clarity / Monster Cart: NOT hand-added here. content_for_header
     is Shopify's own injection point for every app embed and the store's
     configured pixels — the static build had a manual "paste snippets here"
     placeholder because it had no such mechanism. Do not add manual script
     tags for any of these unless something is confirmed missing after a
     live check; duplicate pixels double-count events. -->
{{ content_for_header }}

<link rel="preload" as="image" href="{{ 'hero-b1-front.webp' | asset_url }}" fetchpriority="high">

<style>
  :root {
    --ground: #FBFAF8;
    --ink: #1A1D1C;
    --ink-2: #4A4F4C;
    --accent: #C7A455;
    --accent-ink: #1A1D1C;
    --panel: #F1EFEA;
    --success: #3D6650;
    --rule: #E3DFD6;
    --gap-red: #9C4A3C;

    --font-body: Georgia, 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', serif;
    --font-heading: 'Helvetica Neue', Helvetica, Arial, sans-serif;

    --space-section: 1.1rem;
    --space-front: 0.6rem;
    --measure: 50ch;

    color-scheme: light;
  }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }

  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  img { max-width: 100%; height: auto; display: block; }

  a { color: inherit; }

  h1, h2, h3 {
    font-family: var(--font-heading);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin: 0 0 0.5em;
    color: var(--ink);
  }

  h1 { font-size: clamp(1.9rem, 7vw, 2.6rem); }
  h2 { font-size: clamp(1.4rem, 5.5vw, 1.9rem); }
  h3 { font-size: 1.05rem; text-transform: uppercase; letter-spacing: 0.02em; }

  p { margin: 0 0 0.6em; }
  ul { margin: 0 0 0.6em; padding-left: 1.2em; }
  li { margin-bottom: 0.2em; }

  .wrap.measure { max-width: var(--measure); margin-left: auto; margin-right: auto; }

  .wrap {
    max-width: 640px;
    margin: 0 auto;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  section { padding: var(--space-section) 0; }
  section.on-panel { background: var(--panel); }

  .eyebrow {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0 0 0.75em;
  }

  strong { font-weight: 700; }
  em { font-style: italic; }

  /* Visually hidden but available to assistive tech */
  .vh {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  :focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  /* ---------------- Hero ---------------- */
  .hero { padding-top: 1.25rem; padding-bottom: var(--space-front); }
  .hero-images {
    display: flex;
    gap: 0.75rem;
    margin: 1rem 0 1.1rem;
    justify-content: center;
  }
  .hero-images img {
    width: 45%;
    max-width: 170px;
    height: auto;
  }
  .hero h1 { text-align: left; }
  .hero-price {
    background: var(--panel);
    border-left: 4px solid var(--accent);
    padding: 0.85rem 1rem;
    margin: 1rem 0 0.9rem;
    border-radius: 2px;
  }
  .hero-price .amount {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.15rem;
    margin: 0 0 0.3em;
  }
  .hero-price .calories { color: var(--ink-2); font-size: 0.95rem; margin: 0 0 0.5em; }
  .hero-price .sub { color: var(--ink-2); font-size: 0.95rem; margin: 0; }

  .scroll-cue {
    display: flex;
    justify-content: center;
    padding-top: 0.75rem;
  }
  .scroll-cue svg { width: 22px; height: 22px; color: var(--ink-2); animation: bob 1.8s ease-in-out infinite; }
  @media (prefers-reduced-motion: reduce) {
    .scroll-cue svg { animation: none; }
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  /* ---------------- Trust ribbon ---------------- */
  .trust {
    padding: 0.9rem 0;
    background: var(--ink);
  }
  .trust-list {
    list-style: none;
    margin: 0; padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 1.1rem;
  }
  .trust-list li {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #F1EFEA;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    font-weight: 700;
    white-space: nowrap;
  }
  .trust-list svg { width: 15px; height: 15px; flex: none; color: var(--accent); }

  /* ---------------- Body sections ---------------- */
  #why-carb { padding: var(--space-front) 0; }
  .mechanism-img { margin: 0.6rem 0; border-radius: 4px; overflow: hidden; max-width: 210px; margin-left: auto; margin-right: auto; }

  .founder-photo { margin: 0 0 0.6rem; border-radius: 4px; overflow: hidden; max-width: 210px; margin-left: auto; margin-right: auto; }
  .founder-photo img { width: 100%; height: auto; }
  .founder-signoff { font-style: italic; color: var(--ink-2); }

  /* ---------------- Comparison table ---------------- */
  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 1rem 0;
    border: 1px solid var(--rule);
    border-radius: 4px;
  }
  .table-scroll table {
    border-collapse: collapse;
    width: 100%;
    min-width: 560px;
    font-family: var(--font-heading);
    font-size: 0.85rem;
  }
  .table-scroll caption { text-align: left; padding: 0.75rem 0.9rem 0; font-family: var(--font-body); font-size: 0.85rem; color: var(--ink-2); }
  .table-scroll th, .table-scroll td {
    padding: 0.4rem 0.6rem;
    text-align: center;
    border-bottom: 1px solid var(--rule);
    white-space: nowrap;
  }
  .table-scroll thead th { background: var(--ink); color: #F1EFEA; font-weight: 700; }
  .table-scroll th[scope="row"] { text-align: left; font-weight: 700; white-space: normal; }
  .col-valor { background: rgba(199,164,85,0.16); font-weight: 700; }
  thead th.col-valor { background: var(--accent); color: var(--accent-ink); }
  .cell-gap { color: var(--gap-red); font-weight: 700; }
  .cell-gap .gap-icon { width: 12px; height: 12px; display: inline-block; vertical-align: -1px; margin-right: 3px; }
  .cell-unsourced { color: var(--ink-2); font-style: italic; font-weight: 400; }
  .panel-images { display: flex; flex-direction: row; justify-content: center; gap: 1rem; margin: 1rem 0; }
  .panel-images figure { margin: 0; width: 130px; }
  .panel-images img { border-radius: 4px; width: 130px; height: auto; }
  .panel-images figcaption { font-size: 0.72rem; color: var(--ink-2); margin-top: 0.35rem; text-align: center; }

  /* ---------------- Transformation placeholder ---------------- */
  .before-after h4 {
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.85rem;
    color: var(--ink-2);
    margin: 1.4rem 0 0.5em;
  }
  .before-after h4:first-child { margin-top: 0; }

  .asset-gap {
    margin: 0.85rem 0;
    padding: 0.85rem 0.9rem;
    border: 2px dashed #C9A9A0;
    border-radius: 4px;
    background: #FBF3F0;
    color: #7A4B3F;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    text-align: center;
    line-height: 1.5;
  }
  .asset-gap strong { display: block; font-size: 0.9rem; margin-bottom: 0.3em; }

  /* ---------------- Pull quote (rhythm variant) ---------------- */
  .pull-quote {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.2rem;
    line-height: 1.35;
    color: var(--ink);
    border-top: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    padding: 0.6rem 0;
    margin: 0.85rem 0;
  }

  /* ---------------- CTA blocks ---------------- */
  .cta-block { padding: 1.1rem 0; text-align: center; }
  .cta-block.on-panel { background: var(--panel); }

  .btn-primary {
    display: inline-block;
    width: 100%;
    max-width: 420px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    border: none;
    border-radius: 4px;
    padding: 1.05rem 1.25rem;
    cursor: pointer;
    text-align: center;
  }
  .btn-primary:hover { filter: brightness(0.94); }
  .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; filter: none; }

  .cta-sub { margin: 0.7rem 0 0; font-size: 0.9rem; color: var(--ink-2); }

  /* ---------------- Offer / stack table ---------------- */
  .stack-table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.95rem; }
  .stack-table td { padding: 0.4rem 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .stack-table td:last-child { text-align: right; white-space: nowrap; font-weight: 700; padding-left: 1rem; }
  .stack-table .check { color: var(--success); }
  .stack-table tr:last-child td { border-bottom: none; }

  /* ---------------- Buy panel (shared: inline module + drawer) ---------------- */
  .buy-panel { text-align: left; }
  .flavor-group {
    display: flex;
    gap: 0.6rem;
    margin: 0 0 0.75rem;
  }
  .flavor-option {
    flex: 1;
    position: relative;
  }
  .flavor-option input {
    position: absolute;
    opacity: 0;
    width: 100%; height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .flavor-option label {
    display: block;
    border: 2px solid var(--rule);
    border-radius: 4px;
    padding: 0.65rem 0.6rem;
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--ink);
    background: #fff;
  }
  .flavor-option input:checked + label {
    border-color: var(--accent);
    background: rgba(199,164,85,0.14);
  }
  .flavor-option input:focus-visible + label {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .price-line {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 0.75rem;
    font-family: var(--font-heading);
  }
  .price-line .now { font-size: 1.5rem; font-weight: 800; }
  .price-line .was { font-size: 1rem; color: var(--ink-2); text-decoration: line-through; }
  .price-line .label { font-size: 0.78rem; color: var(--ink-2); text-transform: uppercase; letter-spacing: 0.03em; }

  .upgrade-row {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 0.7rem 0.9rem;
    margin: 0 0 0.85rem;
    background: #fff;
    cursor: pointer;
  }
  .upgrade-row input { margin-top: 0.2rem; width: 18px; height: 18px; flex: none; }
  .upgrade-row .upgrade-copy strong { display: block; font-family: var(--font-heading); font-size: 0.92rem; }
  .upgrade-row .upgrade-copy span { display: block; font-size: 0.82rem; color: var(--ink-2); margin-top: 0.15em; }

  .guarantee-line {
    font-size: 0.88rem;
    color: var(--ink-2);
    margin: 0 0 0.85rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--rule);
  }

  .buy-panel-thumb { width: 84px; height: auto; float: none; margin: 0 0 0.75rem; }

  /* ---------------- Drawer ---------------- */
  dialog#buy-drawer {
    border: none;
    padding: 0;
    margin: 0;
    width: 100%;
    max-width: 100%;
    max-height: min(88vh, 640px);
    background: var(--ground);
    border-radius: 14px 14px 0 0;
    position: fixed;
    inset-block-end: 0;
    inset-block-start: auto;
    inset-inline: 0;
    left: 0;
    transform: translateY(100%);
    transition: transform 0.25s ease-out;
  }
  dialog#buy-drawer[open] { transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    dialog#buy-drawer { transition: none; }
  }
  dialog#buy-drawer::backdrop {
    background: rgba(26,29,28,0.55);
  }
  .drawer-sheet {
    padding: 0.9rem 1.25rem calc(1.5rem + env(safe-area-inset-bottom));
    overflow-y: auto;
    max-height: min(88vh, 640px);
  }
  .drawer-handle {
    width: 36px; height: 4px;
    background: var(--rule);
    border-radius: 2px;
    margin: 0 auto 0.8rem;
  }
  .drawer-close {
    position: absolute;
    top: 0.75rem; right: 0.9rem;
    width: 34px; height: 34px;
    border: none;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .drawer-close svg { width: 18px; height: 18px; }

  @media (min-width: 480px) {
    dialog#buy-drawer {
      max-width: 420px;
      left: auto;
      right: 1.25rem;
      bottom: 1.25rem;
      border-radius: 14px;
    }
  }

  /* ---------------- Sticky bar ---------------- */
  .sticky-bar {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 40;
    background: var(--ink);
    color: #F1EFEA;
    padding: 0.7rem 1rem calc(0.7rem + env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    transform: translateY(100%);
    transition: transform 0.2s ease-out;
  }
  .sticky-bar.is-visible { transform: translateY(0); }
  .sticky-bar[hidden] { display: none; }
  .sticky-bar.is-hidden-for-drawer { transform: translateY(100%); }
  @media (prefers-reduced-motion: reduce) {
    .sticky-bar { transition: none; }
  }
  .sticky-bar-info { min-width: 0; }
  .sticky-bar-name {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #C9C4B8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sticky-bar-price {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.05rem;
  }
  .sticky-bar button {
    flex: none;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.9rem;
    border: none;
    border-radius: 4px;
    padding: 0.65rem 1.1rem;
    cursor: pointer;
  }

  /* ---------------- FAQ ---------------- */
  .faq-item {
    border-bottom: 1px solid var(--rule);
  }
  .faq-item:first-child { border-top: 1px solid var(--rule); }
  .faq-item summary {
    padding: 1rem 1.6rem 1rem 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.98rem;
    cursor: pointer;
    position: relative;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: "+";
    position: absolute;
    right: 0.1rem; top: 0.9rem;
    font-family: var(--font-heading);
    font-size: 1.3rem;
    color: var(--accent);
  }
  .faq-item[open] summary::after { content: "\2212"; }
  .faq-item p { padding-bottom: 1rem; color: var(--ink-2); }

  /* ---------------- Close / footer ---------------- */
  #close { text-align: left; }
  #close .close-final { font-family: var(--font-heading); font-weight: 800; font-size: 1.1rem; }

  footer.site-footer {
    background: var(--ink);
    color: #C9C4B8;
    padding: 2rem 0 calc(2rem + env(safe-area-inset-bottom));
    font-size: 0.8rem;
    line-height: 1.7;
    text-align: center;
  }
  footer.site-footer p { margin: 0 0 0.3em; }
  .disclaimer-slot { margin-top: 1rem; font-size: 0.72rem; color: #8B8778; min-height: 1em; }

  @media (min-width: 640px) {
    body { font-size: 19px; }
    h3 { font-size: 1.1rem; }
    .wrap { max-width: 700px; }
  }

  @media (min-width: 900px) {
    .wrap { max-width: 760px; }
    .panel-images { flex-direction: row; }
    .panel-images figure { flex: 1; }
  }
</style>
</head>
<body>
  {{ content_for_layout }}
</body>
</html>
