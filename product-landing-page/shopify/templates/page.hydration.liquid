<dialog id="buy-drawer" aria-labelledby="drawer-title">
  <div class="drawer-sheet">
    <div class="drawer-handle" aria-hidden="true"></div>
    <button type="button" class="drawer-close" data-close-drawer aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg>
    </button>
    <h2 id="drawer-title" class="vh">Add Valor Vitals Hydration to your order</h2>
    <div class="buy-panel" data-buy-panel data-drawer-instance data-source="">
      <!-- populated by JS -->
    </div>
  </div>
</dialog>

<template id="buy-panel-template">
  <img class="buy-panel-thumb" src="{{ 'hero-b1-front.webp' | asset_url }}" data-thumb alt="Valor Vitals Hydration, 30-stick gusset bag" width="900" height="973">
  <fieldset style="border:none;padding:0;margin:0 0 1rem;">
    <legend class="vh">Choose a flavor</legend>
    <div class="flavor-group" data-flavor-group>
      <div class="flavor-option">
        <input type="radio" name="flavor" value="B1" id="fl-b1">
        <label for="fl-b1">B1 Blue Raspberry</label>
      </div>
      <div class="flavor-option">
        <input type="radio" name="flavor" value="B2" id="fl-b2">
        <label for="fl-b2">B2 Lemon Lime</label>
      </div>
    </div>
  </fieldset>
  <div class="price-line">
    <span class="now" data-total>$29</span>
    <span class="was">$44.99</span>
    <span class="label">first bag</span>
  </div>
  <label class="upgrade-row">
    <input type="checkbox" data-upgrade>
    <span class="upgrade-copy">
      <strong>Add the other flavor — $19</strong>
      <span>Same box. No extra shipping.</span>
    </span>
  </label>
  <p class="guarantee-line">90 days to try it. Keep the bag either way.</p>
  <button type="button" class="btn-primary" data-submit disabled>Try your first bag — $29</button>
</template>

<script>
(function () {
  'use strict';

  var DEBUG = /[?&]debug=1\b/.test(window.location.search);

  var B1_VARIANT = 44474517717091;
  var B2_VARIANT = 44474517749859;
  // Flag: no discount code / automatic-discount name was supplied in any
  // source doc to bring these $44.99 variants to the $29/$19 prices shown
  // on this page. This is a Shopify-admin configuration task, not
  // something this file can fix — do not launch until a live test
  // purchase confirms $29 at checkout.

  /* ============ ANALYTICS CORE ============ */
  function isMobile() {
    return window.matchMedia('(max-width: 767px)').matches;
  }

  function docHeight() {
    return document.documentElement.scrollHeight || document.body.scrollHeight;
  }

  function depthPctFor(el) {
    var top = el.getBoundingClientRect().top + window.scrollY;
    return Math.round((top / docHeight()) * 100);
  }

  function track(name, params) {
    params = params || {};
    if (DEBUG) { console.log('[track]', name, params); }
    try { if (window.gtag) { window.gtag('event', name, params); } } catch (e) {}
    try {
      if (window.fbq) {
        if (name === 'Purchase') { window.fbq('track', 'Purchase', params); }
        else { window.fbq('trackCustom', name, params); }
      }
    } catch (e) {}
    try { if (window.clarity) { window.clarity('event', name); } } catch (e) {}
  }

  /* ============ Section-view scroll depth ============ */
  (function () {
    var ids = ['why-carb', 'formula', 'cta-1', 'compare', 'why-others-quit', 'built-for', 'before-after', 'keep-yours', 'offer', 'guarantee', 'faq', 'close'];
    var fired = {};
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var id = entry.target.id;
        if (fired[id]) return;
        fired[id] = true;
        track('section_view_' + id.replace(/-/g, '_'), {
          section: id,
          depth_pct: depthPctFor(entry.target),
          device: isMobile() ? 'mobile' : 'desktop'
        });
        io.unobserve(entry.target);
      });
    }, { threshold: 0 });
    ids.forEach(function (id) {
      var el = document.getElementById(id);
      if (el) io.observe(el);
    });
  })();

  /* ============ Sticky bar ============ */
  var stickyBar = document.getElementById('sticky-bar');
  var stickyShown = false;
  (function () {
    var sentinel = document.getElementById('sticky-bar-sentinel');
    if (!sentinel) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting && !stickyShown) {
          stickyShown = true;
          stickyBar.hidden = false;
          requestAnimationFrame(function () { stickyBar.classList.add('is-visible'); });
          track('sticky_bar_shown', { depth_pct: depthPctFor(sentinel) });
          io.disconnect();
        }
      });
    }, { threshold: 0 });
    io.observe(sentinel);
  })();
  stickyBar.querySelector('button').addEventListener('click', function () {
    track('sticky_bar_click', { depth_pct: depthPctFor(stickyBar) });
    openDrawer('sticky_bar', this);
  });

  /* ============ Buy panel (shared logic for drawer + inline cta-4) ============ */
  var FLAVOR_NAME = { B1: 'B1 Blue Raspberry', B2: 'B2 Lemon Lime' };
  var FLAVOR_VARIANT = { B1: B1_VARIANT, B2: B2_VARIANT };
  var FLAVOR_THUMB = { B1: '{{ "hero-b1-front.webp" | asset_url }}', B2: '{{ "hero-b2-front.webp" | asset_url }}' };

  function initBuyPanel(container) {
    var tpl = document.getElementById('buy-panel-template');
    container.appendChild(tpl.content.cloneNode(true));

    var source = container.getAttribute('data-source') || 'cta-4';
    var flavorInputs = container.querySelectorAll('input[name="flavor"]');
    var upgrade = container.querySelector('[data-upgrade]');
    var totalEl = container.querySelector('[data-total]');
    var submitBtn = container.querySelector('[data-submit]');
    var thumb = container.querySelector('[data-thumb]');

    function state() {
      var picked = null;
      flavorInputs.forEach(function (r) { if (r.checked) picked = r.value; });
      return { flavor: picked, upgrade: upgrade.checked };
    }

    function currentSource() {
      return container.getAttribute('data-source') || source;
    }

    function render() {
      var s = state();
      var total = s.upgrade ? 48 : 29;
      totalEl.textContent = '$' + total;
      submitBtn.textContent = 'Try your first bag — $' + total;
      submitBtn.disabled = !s.flavor;
      if (s.flavor) { thumb.src = FLAVOR_THUMB[s.flavor]; thumb.alt = 'Valor Vitals ' + FLAVOR_NAME[s.flavor] + ' hydration, 30-stick gusset bag'; }
    }

    flavorInputs.forEach(function (r) {
      r.addEventListener('change', function () {
        render();
        track('drawer_flavor_select', { flavor: r.value, source: currentSource() });
      });
    });

    upgrade.addEventListener('change', function () {
      render();
      track('drawer_upgrade_toggle', { checked: upgrade.checked, source: currentSource() });
    });

    submitBtn.addEventListener('click', function () {
      var s = state();
      if (!s.flavor) return;
      submitToCart(s.flavor, s.upgrade, currentSource());
    });

    render();

    return {
      reset: function () {
        flavorInputs.forEach(function (r) { r.checked = false; });
        upgrade.checked = false;
        render();
      },
      flavorSelected: function () { return !!state().flavor; }
    };
  }

  // Monster Cart owns everything after a successful add-to-cart (see PORT
  // NOTES #2 above). This function used to redirect straight to /checkout
  // on success — that redirect is gone. It now just posts the cart
  // mutation and lets Monster Cart's own site-wide script react, the same
  // way it presumably does on every other product page. The catch-path
  // fallback (cart permalink) is kept for resilience if the fetch itself
  // fails outright — Monster Cart can't react to a request that never
  // succeeded, so this still needs to land the shopper somewhere that
  // works, hence /cart rather than /checkout.
  function submitToCart(flavor, upgrade, source) {
    var total = upgrade ? 48 : 29;
    track('drawer_add_to_cart', { source: source, flavor: flavor, upgrade: upgrade, value: total });
    track('AddToCart', { source: source, flavor: flavor, upgrade: upgrade, value: total, currency: 'USD' });

    var items = [{ id: FLAVOR_VARIANT[flavor], quantity: 1 }];
    if (upgrade) {
      var other = flavor === 'B1' ? 'B2' : 'B1';
      items.push({ id: FLAVOR_VARIANT[other], quantity: 1 });
    }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: items })
    }).then(function (r) {
      if (!r.ok) { throw new Error('cart/add ' + r.status); }
      // Success: no redirect. Monster Cart's own script is expected to
      // take it from here — see PORT NOTES #2. Verify on a live preview.
    }).catch(function () {
      window.location.href = '/cart/' + FLAVOR_VARIANT[flavor] + ':1' + (upgrade ? ',' + FLAVOR_VARIANT[flavor === 'B1' ? 'B2' : 'B1'] + ':1' : '');
    });
  }

  // Inline module at cta-4
  var inlinePanels = [];
  document.querySelectorAll('[data-buy-panel]:not([data-drawer-instance])').forEach(function (el) {
    inlinePanels.push(initBuyPanel(el));
  });

  /* ============ Drawer: open / close / focus trap ============ */
  var drawer = document.getElementById('buy-drawer');
  var drawerContainer = drawer.querySelector('[data-buy-panel]');
  var drawerPanel = initBuyPanel(drawerContainer);
  var lastTrigger = null;
  var openedAt = 0;
  var scrollLockY = 0;

  function lockScroll() {
    scrollLockY = window.scrollY;
    document.body.style.position = 'fixed';
    document.body.style.top = (-scrollLockY) + 'px';
    document.body.style.left = '0';
    document.body.style.right = '0';
  }
  function unlockScroll() {
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.left = '';
    document.body.style.right = '';
    window.scrollTo(0, scrollLockY);
  }

  function getFocusable(root) {
    return Array.prototype.slice.call(
      root.querySelectorAll('a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])')
    ).filter(function (el) { return el.offsetParent !== null; });
  }

  function trapFocus(e) {
    if (e.key !== 'Tab') return;
    var focusable = getFocusable(drawer);
    if (!focusable.length) return;
    var first = focusable[0];
    var last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault(); last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault(); first.focus();
    }
  }

  function openDrawer(source, triggerEl) {
    drawerContainer.setAttribute('data-source', source);
    drawerPanel.reset();
    lastTrigger = triggerEl || document.activeElement;
    openedAt = Date.now();

    // Depth must be captured before lockScroll() sets body{position:fixed},
    // which collapses window.scrollY to 0 for the duration of the lock.
    var depthPct = Math.round((window.scrollY / docHeight()) * 100);

    stickyBar.classList.add('is-hidden-for-drawer');

    drawer.showModal();
    lockScroll();
    document.addEventListener('keydown', trapFocus);

    var focusable = getFocusable(drawer);
    (focusable[0] || drawer).focus();

    track('drawer_open', { source: source, depth_pct: depthPct });
  }

  function closeDrawer(added) {
    if (!drawer.open) return;
    var source = drawerContainer.getAttribute('data-source');
    if (!added) {
      track('drawer_dismiss', {
        source: source,
        seconds_open: Math.round((Date.now() - openedAt) / 1000),
        flavor_selected: drawerPanel.flavorSelected()
      });
    }
    drawer.close();
    unlockScroll();
    document.removeEventListener('keydown', trapFocus);
    stickyBar.classList.remove('is-hidden-for-drawer');
    if (lastTrigger && typeof lastTrigger.focus === 'function') { lastTrigger.focus(); }
  }

  document.querySelectorAll('[data-open-drawer]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      openDrawer(btn.getAttribute('data-open-drawer'), btn);
    });
  });
  drawer.querySelector('[data-close-drawer]').addEventListener('click', function () { closeDrawer(false); });
  drawer.addEventListener('cancel', function (e) { e.preventDefault(); closeDrawer(false); });
  drawer.addEventListener('click', function (e) {
    if (e.target === drawer) { closeDrawer(false); }
  });

  // Close on successful add-to-cart: patch submitToCart's caller to close first.
  drawerContainer.addEventListener('click', function (e) {
    if (e.target.closest('[data-submit]') && drawerPanel.flavorSelected()) {
      // Let submitToCart fire (bound above), then close the sheet immediately —
      // Monster Cart's drawer is expected to take over from here.
      closeDrawer(true);
    }
  });

  /* ============ FAQ open events ============ */
  document.querySelectorAll('.faq-item details').forEach(function (d) {
    d.addEventListener('toggle', function () {
      if (d.open) { track('faq_open', { question_id: d.getAttribute('data-question-id') }); }
    });
  });

  /* ============ Engagement: time on page ============ */
  (function () {
    var marks = [15, 30, 60, 120, 240];
    var maxDepth = 0;
    function updateMaxDepth() {
      var pct = Math.round(((window.scrollY + window.innerHeight) / docHeight()) * 100);
      if (pct > maxDepth) maxDepth = Math.min(pct, 100);
    }
    window.addEventListener('scroll', updateMaxDepth, { passive: true });
    updateMaxDepth();
    var start = Date.now();
    marks.forEach(function (s) {
      setTimeout(function () {
        track('time_on_page', { seconds: s, max_depth_pct: maxDepth });
      }, s * 1000);
    });

    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'hidden') {
        track('page_exit', {
          max_depth_pct: maxDepth,
          seconds: Math.round((Date.now() - start) / 1000),
          reached_cta_1: (function () {
            var el = document.getElementById('cta-1');
            return el ? el.getBoundingClientRect().top < window.innerHeight : false;
          })()
        });
      }
    });
  })();

  /* ============ Rage click ============ */
  (function () {
    var clicks = [];
    document.addEventListener('click', function (e) {
      var now = Date.now();
      clicks.push({ t: now, x: e.clientX, y: e.clientY });
      clicks = clicks.filter(function (c) { return now - c.t < 500; });
      var cluster = clicks.filter(function (c) {
        return Math.abs(c.x - e.clientX) < 40 && Math.abs(c.y - e.clientY) < 40;
      });
      if (cluster.length >= 3) {
        track('rage_click', {
          element: e.target.tagName.toLowerCase() + (e.target.id ? '#' + e.target.id : ''),
          depth_pct: Math.round((window.scrollY / docHeight()) * 100)
        });
        clicks = [];
      }
    });
  })();

})();
</script>
